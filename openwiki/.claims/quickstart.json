    {
      "id": "claim_9889d6479b094771881a219343bc8cdf",
      "statement": "`src/index.ts` is the single server entry point: it creates an Elysia API with the `api` prefix, mounts every widget backend plugin from `WIDGETS`, and starts `Bun.serve` with routes for `/*` and `/api/*`.",
      "evidence": [
        {
          "resource": "repo://src/index.ts#L1-L27",
          "version": "repo-lines-v1:sha256:ef7dd5069e3c309997022d87041f82b94051b215f5f70d21d8186c4210d0c2dc:"
        }
      ]
    },
    {
      "id": "claim_42dec267bc1b4c2d8fc95913156461d7",
      "statement": "`src/frontend.tsx` is the browser entry point: it creates or reuses a React root under `StrictMode`, maps every widget from the shared `WIDGETS` registry into a `{ left, center, right }` column record by `widget.size`, and renders `App` with that record.",
      "evidence": [
        {
          "resource": "repo://src/frontend.tsx#L8-L37",
