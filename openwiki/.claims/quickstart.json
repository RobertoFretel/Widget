        }
      ]
    },
    {
      "id": "claim_97a2d2272f52411d941dd2ef57f6c8aa",
      "statement": "`bun dev` starts the development server by running `bun --hot src/index.ts`, enabling Bun's module hot reload for both server and frontend modules.",
      "evidence": [
        {
          "resource": "repo://package.json#L7-L7",
          "version": "repo-lines-v1:sha256:b8bda8f8f3996a64fa8559c4540cdfe25d01ca67a1aed55a4925ef0931779dc1:"
