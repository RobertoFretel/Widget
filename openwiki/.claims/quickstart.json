    {
      "id": "claim_583509a7fb3343639103daf8e92f1d79",
      "statement": "The project uses Bun as its sole runtime, with package.json scripts invoking `bun` for dev, build, and start and the server entry point using `Bun.serve`.",
      "evidence": [
        {
          "resource": "repo://package.json",
