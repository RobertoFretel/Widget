    {
      "id": "claim_c3aaa052639c47debd5c112d3182f9cc",
      "statement": "`bun run build` produces a minified browser bundle in `dist/`, emits source maps, sets `process.env.NODE_ENV` to `\"production\"`, and inlines only environment variables matching `BUN_PUBLIC_*`.",
      "evidence": [
